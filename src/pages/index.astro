---
import Layout from '../layouts/Layout.astro';
import PlotCard from '../components/PlotCard.astro';
import { plotConfigs } from '../assets/plotConfigs.js';
---

<Layout>
  <Fragment slot="head">
    <title>TP Développement de Services - Plot</title>
  </Fragment>

  <main class="min-h-screen px-6 py-10 text-slate-100">
    <div class="mx-auto max-w-6xl">
      <header class="mb-12 pt-6">
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.22em] text-amber-200">
          Palmer Penguins · Observable Plot
        </p>
        <h1 class="text-4xl font-bold tracking-tight text-white md:text-6xl">
          Les pingouins
        </h1>
        <p class="mt-5 max-w-2xl text-base leading-7 text-slate-200 md:text-lg">
          Explorez les liens entre morphologie, masse et espèces à travers des visualisations interactives.
        </p>
      </header>

      <a
        href="/slider"
        class="card group mb-12 block text-left text-white no-underline transition hover:-translate-y-1"
        aria-label="Découvrir le slider des espèces"
      >
        <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
          <div class="max-w-3xl">
            <p class="eyebrow">Explorer les espèces</p>
            <h2 class="mt-3 text-3xl font-semibold text-white md:text-4xl">
              Comparez les manchots en un seul parcours
            </h2>
            <p class="mt-4 max-w-2xl text-base leading-7 text-slate-200">
              Retrouvez dans le slider les graphiques dédiés aux espèces Adelie, Gentoo et Chinstrap,
              puis cliquez sur chaque visualisation pour consulter sa page détaillée.
            </p>
          </div>
          <span class="inline-flex shrink-0 items-center gap-2 font-semibold text-amber-200">
            Ouvrir le slider
            <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">→</span>
          </span>
        </div>
      </a>

      <section aria-labelledby="charts-title" class="mt-8">
        <h2 id="charts-title" class="mb-6 text-2xl font-semibold text-white">
          Choisir une visualisation
        </h2>
        <div class="grid gap-6 md:grid-cols-3">
          {plotConfigs.map((plot) => (
            <PlotCard slug={plot.slug} title={plot.title} hook={plot.hook} />
          ))}
        </div>
      </section>
    </div>
  </main>
</Layout>