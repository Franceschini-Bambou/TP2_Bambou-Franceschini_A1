---
import Layout from "../../layouts/Layout.astro";
import GraphicSpecies from "../../components/GraphicSpecies.astro";

const species = "Chinstrap";
---

<Layout>
  <main class="container detail-page">
    <div class="species-shell">
      <a href="/slider" class="back-chip" aria-label="Retour au slider">
        <span aria-hidden="true">←</span>
        Retour
      </a>

      <article class="species-card">
        <header class="species-header">
          <p class="eyebrow">Espèce</p>
          <h1>{species}</h1>
        </header>

        <div class="species-chart-wrap">
          <GraphicSpecies species={species} />
        </div>
      </article>
    </div>
  </main>
</Layout>