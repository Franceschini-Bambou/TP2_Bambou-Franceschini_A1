---
import GraphicSpecies from "../components/GraphicSpecies.astro";
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <title>Slider des Manchots</title>
  </head>
  <body class="p-8 bg-gray-50">
    
    <!-- Menu avec ancres -->
    <nav class="fixed top-4 left-4 bg-white p-4 shadow rounded-lg z-10 flex gap-4">
      <a href="#adelie" class="menu-item p-2 rounded transition-colors">Adelie</a>
      <a href="#gentoo" class="menu-item p-2 rounded transition-colors">Gentoo</a>
      <a href="#chinstrap" class="menu-item p-2 rounded transition-colors">Chinstrap</a>
    </nav>

    <!-- Conteneur du Slider Horizontal -->
    <div class="flex overflow-x-auto snap-x snap-mandatory gap-8 mt-20 pb-4">
      <div id="adelie" class="item snap-center shrink-0 w-[600px]">
        <h2 class="text-xl font-semibold mb-2">Adelie</h2>
        <GraphicSpecies species="Adelie" />
      </div>

      <div id="gentoo" class="item snap-center shrink-0 w-[600px]">
        <h2 class="text-xl font-semibold mb-2">Gentoo</h2>
        <GraphicSpecies species="Gentoo" />
      </div>

      <div id="chinstrap" class="item snap-center shrink-0 w-[600px]">
        <h2 class="text-xl font-semibold mb-2">Chinstrap</h2>
        <GraphicSpecies species="Chinstrap" />
      </div>
    </div>

  </body>
</html>