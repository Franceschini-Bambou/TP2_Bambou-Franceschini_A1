---
import * as Plot from "@observablehq/plot";
import { JSDOM } from "jsdom";
import penguins from "../assets/penguins.json";

const { species } = Astro.props;
const penguinsSpecies = penguins.filter(({ species: currentSpecies }) => currentSpecies === species);

// Correction des clés : culmen_length_mm et culmen_depth_mm au lieu de bill_*
const validSpeciesData = penguinsSpecies.filter(
  (d) => d.culmen_length_mm != null && d.culmen_depth_mm != null && d.sex != null,
);

const { document } = new JSDOM("<!DOCTYPE html><html><body></body></html>").window;

const sexColors: Record<string, string> = {
  FEMALE: "#4269d0",
  MALE: "#efb118",
  default: "#ff725c",
};

const legendItems = [
  { label: "FEMELLE", color: sexColors.FEMALE },
  { label: "MALE", color: sexColors.MALE },
  { label: "Autre", color: sexColors.default },
];

const getSexColor = (sex: string | undefined | null): string => {
  const normalizedSex = String(sex ?? "default").toUpperCase();
  return sexColors[normalizedSex] ?? sexColors.default;
};

const plot = Plot.dot(validSpeciesData, {
  x: (d) => d.culmen_length_mm,
  y: (d) => d.culmen_depth_mm,
  stroke: (d) => getSexColor(d.sex),
  fill: (d) => getSexColor(d.sex),
  r: 4,
  opacity: 0.85,
  tip: true,
}).plot({
  document,
  inset: 12,
  grid: true,
  x: { label: "Longueur du bec (mm)", nice: true },
  y: { label: "Profondeur du bec (mm)", nice: true },
  title: `Manchots ${species}`,
  style: {
    background: "#ffffff",
    color: "#0f172a", // Force un texte sombre bien lisible
    fontFamily: "system-ui, sans-serif",
    fontSize: "12px",
  },
});
---

<div class="overflow-hidden rounded-2xl border border-white/15 bg-slate-900/40 p-3 shadow-2xl backdrop-blur-md">
  <div class="rounded-xl bg-white p-2 text-slate-900">
    <div class="mb-2 flex flex-wrap items-center gap-4 px-1 text-[11px] font-medium text-slate-700">
      {legendItems.map((item) => (
        <div class="flex items-center gap-2">
          <span
            class="inline-block h-3 w-3 rounded-sm border border-slate-300"
            style={{ backgroundColor: item.color }}
          />
          <span>{item.label}</span>
        </div>
      ))}
    </div>
    <Fragment set:html={plot.outerHTML} />
  </div>
</div>